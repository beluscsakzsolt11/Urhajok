<Window x:Class="Urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Label Content="Űrhajó műveletek" FontSize="30" Margin="10"/>
            <Button x:Name="adatbetolt" Width="200" Height="25" Content="Adatok betöltése" Margin="10" Click="adatbetolt_Click"/>
            <Button x:Name="hanyurhajo" Width="200" Height="25" Content="Hány űrhajó van?" Margin="10" Click="hanyurhajo_Click"/>
            <Button x:Name="maxhatotav" Width="200" Height="25" Content="Melyiknek a legnagyobb a hatótáva?" Margin="10" Click="maxhatotav_Click"/>
            <Button Width="200" Height="25" Content="Kik voltak sikeres küldetésen?" Margin="10"/>
            <Button Width="200" Height="25" Content="Átlagos legénységszám" Margin="10"/>
            <Button Width="200" Height="25" Content="Gyártók szerinti csoportosítás" Margin="10"/>
            <Button Width="200" Height="25" Content="Keresés név alapján" Margin="10"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <DataGrid Margin="10" x:Name="datagrid"/>
        </StackPanel>
    </Grid>
</Window>
